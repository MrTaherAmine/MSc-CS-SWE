{
  "display_information": {
    "name": "High School Learning Bot",
    "description": "Educational bot demonstrating Slack Events API, slash commands, and Bolt for JavaScript.",
    "background_color": "#2563EB"
  },
  "features": {
    "bot_user": {
      "display_name": "Learning Bot",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/hello",
        "description": "Receive a greeting from the learning bot",
        "should_escape": false
      },
      {
        "command": "/bot-help",
        "description": "Show the bot help message",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "channels:history",
        "commands"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.channels"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}